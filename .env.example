# VitaTrack Environment Configuration Template
# NOTE: Never commit production credentials to version control.

# Backend Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
MONGO_URI=mongodb://localhost:27017/VitaTrack
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# JWT Secrets (Generate high-entropy strings for production)
JWT_ACCESS_SECRET=VitaTrack_dev_access_secret_do_not_use_in_prod_min_32_chars!
JWT_REFRESH_SECRET=VitaTrack_dev_refresh_secret_do_not_use_in_prod_min_32_chars!
ADMIN_JWT_SECRET=VitaTrack_dev_admin_secret_do_not_use_in_prod_min_32_chars!

# Optional AI Explainer Key (Deferred to Phase 4)
# GEMINI_API_KEY=your_gemini_api_key_here

# Redis In-Memory Cache & Distributed Rate Limiting (Phase E)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Mobile Client Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
